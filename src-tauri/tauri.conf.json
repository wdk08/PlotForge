{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlotForge",
  "version": "1.1.0",
  "identifier": "com.plotforge.desktop",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/plotforge"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PlotForge",
        "width": 1440,
        "height": 1000,
        "minWidth": 720,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'self' about:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Your local story planning room",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NEMyMEIyMzEzQTJFNzcKUldSM0xqb3hzaUJNR1FYSHphVXVXWm5uSVJObXpyMUJsM3JROHh4TlgwMWl6U0g0eldrZFdkTHYK",
      "endpoints": [
        "https://github.com/wdk08/PlotForge/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
